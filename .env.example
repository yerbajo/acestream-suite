# acestream-suite — the deployment values. `cp .env.example .env` and edit.
#
# Every name here is interpolated by docker-compose.yml (`${NAME:-default}`), so a value set here
# reaches the container and the compose file itself never has to be edited. Anything you leave out
# falls back to the safe default written in the compose.
#
# The app has a second, higher authority for some of these: they are saved settings in its Ajustes
# page, and a saved value wins over the environment. That is deliberate — a wrong `.env` is fixable
# from the UI without a rebuild.
#
# The old `ACELIST_*` names are still read as a fallback for one version, so a deployment that has
# not been renamed yet keeps working.

# --- The engine ------------------------------------------------------------------------------
# Base URL of the AceStream engine's HTTP API, as the container reaches it. `127.0.0.1` only works
# if the engine runs on the same host and shares the network namespace; otherwise give the address.
ACESTREAM_SUITE_ENGINE_URL=http://127.0.0.1:6878

# The Linux 3.2.x engine only streams with `infohash=`; the Windows 3.1.x build upstream targets
# takes `id=`. Change it if the engine answers "failed to load content".
ACESTREAM_SUITE_STREAM_PARAM=infohash

# Availability checks at once. Each one is a live engine session, so this is the load on the engine.
ACESTREAM_SUITE_CHECK_CONCURRENCY=2

# --- Language of the interface ---------------------------------------------------------------
# es (default), en, fr, it, de, ru, zh, ja. A saved value in the settings page wins over this.
ACESTREAM_SUITE_LANGUAGE=es

# --- Reachability and playback ---------------------------------------------------------------
# `host` or `host:port`, comma separated: the addresses you browse the app by. The same list feeds
# the Host check and the CSRF origin check — without it, every LAN request is a 400 and every write
# a 403. `localhost` is always accepted on top of this list. Empty is right for a loopback-only
# install and wrong the moment you open it from another machine.
ACESTREAM_SUITE_ALLOWED_HOSTS=

# `vlc` opens a local player (desktop). `url` starts the engine session and hands the link to the
# page — what a container needs, since it has no player. Keep `url` under Docker.
ACESTREAM_SUITE_PLAYBACK_MODE=url

# Port published on the host. The app always listens on 8000 inside the container.
ACESTREAM_SUITE_PORT=8080

# --- The guide (EPG) -------------------------------------------------------------------------
# XMLTV sources, as a JSON list of URLs. Empty (or unset) means no guide, which is supported: the
# catalogue works without one.
ACESTREAM_SUITE_EPG_SOURCES=["https://www.tdtchannels.com/epg/TV.xml.gz","https://epgshare01.online/epgshare01/epg_ripper_ES1.xml.gz"]

# How far ahead of now the guide is kept; older programmes are pruned at every refresh.
ACESTREAM_SUITE_EPG_WINDOW_HOURS=72

# --- The HLS bridge --------------------------------------------------------------------------
# Content-id aliases: serve the stream of one hash under another, so a link a player already has
# cached keeps working after the catalogue moves that channel to a better source. JSON object of
# `"<old hash>": "<new hash>"`, empty is the right default.
HLS_ALIASES=

# --- Not here --------------------------------------------------------------------------------
# Set these in the app's Ajustes page instead, where a saved value beats the environment: engine
# timeout, search URL (empty = the engine's address), check timeout, minimum peers, screenshot
# timeout, ffmpeg path and VLC path.
#
# These have no `.env` name on purpose — the image fixes them and a deployment that needs another
# value adds it to `environment:` in docker-compose.yml: the data directory (`/data`, the mounted
# volume), the guide's per-source timeout and maximum source size, and the actor name recorded for a
# manual channel<->guide decision.
