# acestream-suite, built locally from the AceList upstream source — the first image this
# repository builds instead of pulling.
#
# That is not a style choice: upstream publishes no image. AceList's only supported way to run is
# the Windows one (`start.bat` -> `start.ps1` -> PyInstaller, see `windows/`), so there is nothing to
# pull and the deployment has to build it. See odd/tasks/acelist.md.
#
#   docker compose build && docker compose up -d
#
# The build takes the release TARBALL, not a git clone and not the moving `:latest` of anything.
# The tag URL is pinned by version AND by sha256: GitHub serves the tarball of the tag that exists
# today, and the checksum is what makes this build the same build tomorrow. When upstream cuts
# 1.4.0, nothing changes here until someone bumps the two ARGs and re-reads BOTH patches against the
# new source: `acestream-suite-lan.patch` (LAN reachability and playback) and `acestream-suite-guide.patch` (the
# guide), each with the script that regenerates it next to it.

FROM python:3.12-slim

# Upstream's CI (.github/workflows/ci.yml) tests 3.11 and 3.12. 3.12 is what this image runs, so a
# green CI run means something for the artefact that is actually deployed.
#
# ffmpeg is NOT optional: the app grabs a frame from a live stream for the channel screenshots and
# the availability verification, and it looks for ffmpeg on PATH (`ACESTREAM_SUITE_FFMPEG_PATH` is unset).
# It is the largest layer in this image.
# `patch` applies the local diffs; the app is not forked, so upstream stays upstream.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl ffmpeg patch \
 && rm -rf /var/lib/apt/lists/*

# These two pin the *upstream base*, which is the AceList project (github.com/fabiomb/AceList):
# they are not our product's name and must stay in step with upstream's release tags.
ARG ACELIST_VERSION=1.3.0
ARG ACELIST_SHA256=487bee2f792d2bd30029a32bbd33b9f023cfc0d033c05fdb74bb2e169c72d879

WORKDIR /app
# Three local patches, applied in this order: the LAN/playback one this deployment has always
# carried, then the guide (EPG) one that used to live in the duplicate deployment, then the acesearch
# one (the search page and its settings). Each is a diff of the previous state, all are read against
# the same pinned tarball, and each is regenerated by `build-patch.sh` — so `docker compose build`
# rebuilds the app from upstream plus the three diffs.
COPY acestream-suite-lan.patch /tmp/acestream-suite-lan.patch
COPY acestream-suite-guide.patch /tmp/acestream-suite-guide.patch
COPY acestream-suite-search.patch /tmp/acestream-suite-search.patch

RUN set -eux; \
    curl -fsSL -o /tmp/upstream.tar.gz \
      "https://github.com/fabiomb/AceList/archive/refs/tags/v${ACELIST_VERSION}.tar.gz"; \
    echo "${ACELIST_SHA256}  /tmp/upstream.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/upstream.tar.gz --strip-components=1 -C /app; \
    patch -p1 < /tmp/acestream-suite-lan.patch; \
    patch -p1 < /tmp/acestream-suite-guide.patch; \
    patch -p1 < /tmp/acestream-suite-search.patch; \
    rm -f /tmp/upstream.tar.gz /tmp/acestream-suite-lan.patch /tmp/acestream-suite-guide.patch /tmp/acestream-suite-search.patch

# Editable on purpose. The app reads its templates, its static files AND `alembic.ini` +
# `migrations/` relative to the `app` package's parent (`app/config.py:ROOT_DIR`, via
# `resource_dir()`), so it must run from a source tree; a plain install would move the package into
# site-packages and depend on `package-data` being configured exactly right for the templates to
# come along. This is also how upstream itself runs it.
RUN pip install --no-cache-dir -e .

COPY entrypoint.sh /entrypoint.sh
RUN chmod 0755 /entrypoint.sh

# The catalogue (SQLite) and the screenshots are the whole application state, in one directory.
# PYTHONDONTWRITEBYTECODE: the source tree is root-owned and the container runs as 1000:1000, so
# there is no point in trying to write __pycache__ on every start.
ENV ACESTREAM_SUITE_DATA_DIR=/data \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
VOLUME ["/data"]

# The app listens on 8000 inside the container; the published port is decided in docker-compose.yml.
EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
