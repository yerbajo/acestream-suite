+    assert "propuestas:" in out
+
+
+def test_auto_maps_only_what_it_trusts(db_factory, capsys):
+    with db_factory() as session:
+        channel = make_channel(session, "DAZN1")
+        guide = make_guide(session, "DAZN 1", "d1")
