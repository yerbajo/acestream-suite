+{% extends "base.html" %}
+
+{% block title %}Guía · AceList{% endblock %}
+
+{% set kind_labels = {"exact": "exacta", "containment": "continencia", "fuzzy": "difusa", "below": "débil"} %}
+{% set score_fmt = "%.2f" %}
+
+{% block content %}
+<div class="page-head">
+  <h1>Guía</h1>
+  <div class="actions">
+    <a class="button" href="{{ url_for('channel_list') }}">Canales</a>
+  </div>
+</div>
+<p class="hint">Cada canal del catálogo que se asigna a un canal de guía muestra su programación. Un canal sin guía se queda en blanco; una asignación equivocada miente sobre lo que se está emitiendo, así que lo que no esté claro es mejor dejarlo sin asignar.</p>
+
+{% if mapping.total == 0 %}
+<section class="empty-state">
+  <p class="empty-title">Todavía no hay canales en el catálogo.</p>
+  <p>Cuando siembres canales, podrás asignarles la guía desde aquí.</p>
+</section>
+{% elif mapping.guides == 0 %}
+<section class="empty-state">
+  <p class="empty-title">Todavía no hay canales de guía.</p>
+  <p>La guía está vacía, así que no hay nada a lo que asignar un canal. Ejecuta <code>python -m app.cli epg-refresh</code> cuando haya fuentes configuradas.</p>
+</section>
+{% else %}
+<p class="result-count">{{ mapping.mapped }} con guía · {{ mapping.unmapped_total }} sin guía · {{ mapping.manual }} decisiones manuales · {{ mapping.guides }} canales de guía</p>
+
+{% if mapping.unmapped_total == 0 %}
+<section class="empty-state">
+  <p class="empty-title">Todos los canales tienen guía.</p>
+  <p>No queda ninguno por asignar.</p>
+</section>
+{% else %}
+<h2>Canales sin guía</h2>
+<ul class="mapping-list">
+  {% for item in mapping.unmapped %}
+  <li class="mapping-item">
+    <p class="mapping-title">
+      <a href="{{ url_for('channel_detail', channel_id=item.channel_id) }}">{{ item.title }}</a>
+      <span class="hint">[{{ item.channel_id }}]</span>
+    </p>
+    {% if item.manual %}
+    <p class="hint">Decisión manual: el matcher no propone nada. Quita la decisión al final de la página para volver a ver propuestas.</p>
+    {% else %}
+    <p class="candidates">
+      {% for candidate in item.candidates %}
+      <span class="candidate">
+        <form class="inline" method="post" action="{{ url_for('epg_mapping_set', channel_id=item.channel_id) }}" hx-disabled-elt="find button">
+          <input type="hidden" name="guide_id" value="{{ candidate.epg_channel_id }}">
+          <button type="submit" class="button">Asignar</button>
+        </form>
+        <span class="candidate-name">{{ candidate.name }}</span>
+        <span class="hint">{{ score_fmt | format(candidate.score) }} {{ kind_labels[candidate.kind] }}</span>
+        {% if candidate.leftover %}<span class="hint candidate-leftover">{{ candidate.leftover }}</span>{% endif %}
+      </span>
+      {% else %}
+      <span class="hint">El matcher no propone nada.</span>
+      {% endfor %}
+    </p>
+    {% endif %}
+    <div class="guide-pick">
+      <input type="search" name="q" class="guide-search" placeholder="Buscar en la guía"
+             aria-label="Buscar en la guía para {{ item.title }}"
+             hx-get="{{ url_for('epg_mapping_guides') }}" hx-target="#guides-{{ item.channel_id }}"
